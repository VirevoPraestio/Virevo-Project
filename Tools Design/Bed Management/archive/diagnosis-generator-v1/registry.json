{
 "registry": "Bed Management · Diagnosis canvas blocks",
 "registry_version": 1,
 "updated": "2026-09-30",
 "note": "The block database for Bed Management Diagnosis turns. Claude writes only the JSON spec; bm_diagnosis_html.py validates it against this file and draws the canvas. Every block is Bed Management only unless marked universal.",
 "budget": {
  "max_blocks": 4,
  "note": "Heading excluded. Pages are roomy: a desktop canvas may run to 1.5–2 screens."
 },
 "tones": {
  "rule": "The colours never change between turns; the background theme does. The generator picks it from the turn number in sets of four: turns 1–4 the morning count, 5–8 the lamp-lit sheet, 9–12 the morning count, and so on. Specs store no colour. The one exception: a fill-in-the-blank and its answered redraw keep the theme they started in, so the redraw names redraw_of and sets canvas.tone to that turn's theme.",
  "set_size": 4,
  "rotation": [
   "count",
   "lamp"
  ],
  "list": {
   "count": {
    "status": "approved",
    "name": "The morning count (base)",
    "ground": "#E1E7EF",
    "card": "#FAFCFE",
    "ink": "#1A2B45",
    "muted": "#475672",
    "line": "#B2BED0",
    "soft": "#E9EFF7",
    "grey": "#8B96AA",
    "paper": "none"
   },
   "lamp": {
    "status": "draft",
    "name": "The lamp-lit sheet (warm paper, every other set of four)",
    "ground": "#F2EDE3",
    "card": "#FFFDF8",
    "ink": "#1A2B45",
    "muted": "#4F5870",
    "line": "#CFC7B6",
    "soft": "#EAE3D5",
    "grey": "#8B96AA",
    "paper": "dots"
   }
  }
 },
 "variety": {
  "rule": "Every turn in the place looks different. The main block (the first after the heading) is used by one turn only. No block other than heading and effect appears in two turns in a row. The one exception is a fill-in-the-blank and its answered redraw (06 §10.2): the redraw names redraw_of and reuses that turn's main block, and must add at least one block the blank turn did not have.",
  "repeatable": [
   "heading",
   "effect"
  ],
  "effect_styles": [
   "tag",
   "stamp",
   "ticket",
   "banner",
   "meter"
  ]
 },
 "turn_recipes": {
  "reveal": [
   "revenue-dial",
   "effect"
  ],
  "agenda": [
   "clipboard"
  ],
  "question": [
   "pattern-pair",
   "clipboard"
  ],
  "data-ask": [
   "admission-line",
   "bill-slips",
   "figure-cards"
  ],
  "data-back": [
   "admission-line",
   "bill-slips",
   "time-split",
   "gap-ruler",
   "effect"
  ],
  "sizing": [
   "step-ledger",
   "effect"
  ],
  "findings": [
   "pin-board"
  ],
  "diagnosis": [
   "rule-loop"
  ]
 },
 "withheld_in_fact_turns": [
  "step-ledger"
 ],
