{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "tojo-response.schema.json",
 "title": "Tojo response spec",
 "description": "The single JSON object Claude returns for every Tojo turn. Chat parts are rendered by the app; canvas blocks are validated against blocks/registry.json and rendered offline by generator/tojo_html.py.",
 "type": "object",
 "required": [
  "turn",
  "chat"
 ],
 "additionalProperties": false,
 "properties": {
  "turn": {
   "type": "object",
   "required": [
    "id",
    "type"
   ],
   "properties": {
    "id": {
     "type": "string",
     "description": "stable id, e.g. dp-07; used for stubs and revisions"
    },
    "type": {
     "enum": [
      "question",
      "data-ask",
      "data-back",
      "findings",
      "diagnosis",
      "overview",
      "part",
      "elaboration",
      "progress",
      "challenge",
      "recommendation",
      "scripted"
     ]
    },
    "register": {
     "enum": [
      "guided",
      "advisory"
     ]
    },
    "tool": {
     "type": "string"
    },
    "context": {
     "type": "string"
    },
    "subject": {
     "type": "string",
     "description": "for theme alternation"
    },
    "user_message": {
     "type": "string"
    },
    "user_tag": {
     "type": "string",
     "pattern": "^(@Point\\d+ ?)+$"
    },
    "user_words": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "jargon the user used first; allowed back in this turn"
    }
   }
  },
  "chat": {
   "type": "object",
   "required": [
    "text",
    "prompts"
   ],
   "additionalProperties": false,
   "properties": {
    "text": {
     "oneOf": [
      {
       "type": "string"
      },
      {
       "type": "array",
       "items": {
        "type": "string"
       },
       "maxItems": 3
      }
     ]
    },
    "bullets": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "maxItems": 4
    },
    "pointer": {
     "type": "string"
    },
    "invite": {
     "type": "string"
    },
    "note": {
     "type": "string",
     "description": "Tojo's Note: one line, ≤16 words"
    },
    "question": {
     "type": "object",
     "required": [
      "text",
      "options"
     ],
     "properties": {
      "text": {
       "type": "string"
      },
      "options": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "minItems": 2,
       "maxItems": 5
      },
      "free_text": {
       "type": "boolean"
      }
     }
    },
    "points": {
     "type": "array",
     "minItems": 2,
     "maxItems": 6,
     "items": {
      "type": "object",
      "required": [
       "n",
       "label"
      ],
      "properties": {
       "n": {
        "type": "integer",
        "minimum": 1
       },
       "label": {
        "type": "string"
       },
       "canvas": {
        "type": "boolean"
       }
      }
     }
    },
    "prompts": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 3,
     "maxItems": 3
    }
   }
  },
  "canvas": {
   "type": "object",
   "required": [
    "blocks"
   ],
   "properties": {
    "blocks": {
     "type": "array",
     "minItems": 1,
     "maxItems": 5,
     "items": {
      "type": "object",
      "required": [
       "type"
      ],
      "properties": {
       "type": {
        "type": "string",
        "description": "a block id from blocks/registry.json; remaining keys are that block's slots"
       }
      }
     }
    },
    "tone": {
     "enum": [
      "sage",
      "mist"
     ],
     "description": "Leave out. The generator picks the shade from the turn number. Set only on a fill-in-the-blank redraw, to keep the tone it started in."
    }
   }
  },
  "block_requests": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "needed",
     "closest"
    ],
    "properties": {
     "needed": {
      "type": "string"
     },
     "closest": {
      "type": "string"
     },
     "missing": {
      "type": "string"
     }
    }
   }
  },
  "review": {
   "type": "object",
   "description": "set by the reviewer, never by Claude",
   "properties": {
    "status": {
     "enum": [
      "approved",
      "changes_requested",
      "draft"
     ]
    },
    "date": {
     "type": "string"
    },
    "note": {
     "type": "string"
    }
   }
  }
 }
}