{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "reply-check-report.schema.json",
 "title": "Tojo reply-check: per-turn record and end-of-day report",
 "description": "Two contracts from rules/always-on/09-reply-check-rules.md. $defs.turn_record is the reply_check object Tojo attaches to every turn (09 §9): beside the response text in the regular chat, as a field of the JSON spec in a tool. The app stores it and never shows it. The root object is the end-of-day report Tojo writes at midnight India time from the day's records (09 §10). The app sends it to the back-end agent, which reads it with Backend Agent/skills/reply-check-review.",
 "type": "object",
 "required": [
  "report_id",
  "day",
  "deployment",
  "written_at",
  "files_read",
  "totals",
  "findings"
 ],
 "additionalProperties": false,
 "properties": {
  "report_id": {
   "type": "string",
   "pattern": "^rc-\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$",
   "description": "rc-<day>-<deployment>, e.g. rc-2026-10-07-nagpur-300"
  },
  "day": {
   "type": "string",
   "format": "date",
   "description": "The day covered, midnight to midnight, Asia/Kolkata"
  },
  "deployment": {
   "type": "string",
   "description": "The app's id for the hospital or install the report covers. Never a person's name."
  },
  "written_at": {
   "type": "string",
   "format": "date-time"
  },
  "files_read": {
   "type": "array",
   "minItems": 1,
   "description": "Every rule, playbook, reference and skill file Tojo read that day, with the version or date he read. Suggested changes are judged against these exact versions.",
   "items": {
    "type": "object",
    "required": [
     "file",
     "version"
    ],
    "additionalProperties": false,
    "properties": {
     "file": {
      "type": "string",
      "description": "Path as the files are kept, e.g. rules/06-html-response-rules.md"
     },
     "version": {
      "type": "string",
      "description": "Version label, date, or content hash"
     }
    }
   }
  },
  "totals": {
   "type": "object",
   "required": [
    "chats",
    "counted_turns",
    "ratings",
    "misses",
    "resets",
    "reworks_recovered",
    "findings"
   ],
   "additionalProperties": false,
   "properties": {
    "chats": {
     "type": "integer",
     "minimum": 0
    },
    "counted_turns": {
     "type": "integer",
     "minimum": 0
    },
    "ratings": {
     "type": "object",
     "required": [
      "good",
      "fine",
      "bad",
      "skipped"
     ],
     "additionalProperties": false,
     "properties": {
      "good": {
       "type": "integer",
       "minimum": 0
      },
      "fine": {
       "type": "integer",
       "minimum": 0
      },
      "bad": {
       "type": "integer",
       "minimum": 0
      },
      "skipped": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "misses": {
     "type": "object",
     "description": "Count of replies in each miss class, plus unsure readings",
     "required": [
      "ignored",
      "not_understood",
      "changed_subject",
      "rating_fine",
      "rating_bad",
      "unsure"
     ],
     "additionalProperties": false,
     "properties": {
      "ignored": {
       "type": "integer",
       "minimum": 0
      },
      "not_understood": {
       "type": "integer",
       "minimum": 0
      },
      "changed_subject": {
       "type": "integer",
       "minimum": 0
      },
      "rating_fine": {
       "type": "integer",
       "minimum": 0
      },
      "rating_bad": {
       "type": "integer",
       "minimum": 0
      },
      "unsure": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "resets": {
     "type": "integer",
     "minimum": 0
    },
    "reworks_recovered": {
     "type": "integer",
     "minimum": 0,
     "description": "Resets whose next reply was not a miss"
    },
    "ask_directly": {
     "type": "integer",
     "minimum": 0,
     "description": "Chats that reached a third reset (09 §5.4)"
    },
    "findings": {
     "type": "object",
     "required": [
      "high",
      "medium",
      "low"
     ],
     "additionalProperties": false,
     "properties": {
      "high": {
       "type": "integer",
       "minimum": 0
      },
      "medium": {
       "type": "integer",
       "minimum": 0
      },
      "low": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "by_tool": {
     "type": "array",
     "description": "Optional split of the same totals by tool and place",
     "items": {
      "type": "object",
      "required": [
       "tool",
       "place",
       "counted_turns",
       "misses"
      ],
      "properties": {
       "tool": {
        "type": "string"
       },
       "place": {
        "$ref": "#/$defs/place"
       },
       "counted_turns": {
        "type": "integer",
        "minimum": 0
       },
       "misses": {
        "type": "integer",
        "minimum": 0
       },
       "resets": {
        "type": "integer",
        "minimum": 0
       }
      }
     }
    }
   }
  },
  "findings": {
   "type": "array",
   "description": "Ordered high, then medium, then low. Empty when the day had no misses.",
   "items": {
    "$ref": "#/$defs/finding"
   }
  },
  "user_notes": {
   "type": "array",
   "description": "One user's way of working, not a fault in the rules (09 §10.4)",
   "items": {
    "$ref": "#/$defs/user_note"
   }
  },
  "repeats": {
   "type": "array",
   "description": "Findings matching a change approved on an earlier day: the change has not worked yet (09 §10.2 item 5)",
   "items": {
    "type": "object",
    "required": [
     "finding_id",
     "earlier_change_id",
     "approved_on"
    ],
    "additionalProperties": false,
    "properties": {
     "finding_id": {
      "type": "string"
     },
     "earlier_change_id": {
      "type": "string",
      "description": "The change_id as the back end recorded it when approved"
     },
     "approved_on": {
      "type": "string",
      "format": "date"
     },
     "note": {
      "type": "string",
      "maxLength": 300
     }
    }
   }
  }
 },
 "$defs": {
  "place": {
   "enum": [
    "chat",
    "home",
    "diagnosis",
    "solutions",
    "automations",
    "processes"
   ],
   "description": "chat = the regular chat; the others are the places inside a tool"
  },
  "priority": {
   "enum": [
    "high",
    "medium",
    "low"
   ]
  },
  "cause": {
   "enum": [
    "off_playbook",
    "misread_reference",
    "missed_the_ask",
    "wrong_question",
    "too_long",
    "unclear_words",
    "wrong_register",
    "invented_figure",
    "user_side",
    "unknown"
   ],
   "description": "The fixed list in 09 §7. Codes never change meaning; new ones are added only by the back end."
  },
  "reply_class": {
   "enum": [
    "answered",
    "deferred",
    "prompt_picked",
    "points_added",
    "moved_on_by_button",
    "follow_up",
    "new_info",
    "no_ask",
    "rating_good",
    "rating_skipped",
    "unsure",
    "ignored",
    "not_understood",
    "changed_subject",
    "rating_fine",
    "rating_bad"
   ],
   "description": "09 §3. The last five are misses; unsure is recorded but never a miss."
  },
  "sources": {
   "type": "object",
   "description": "What Tojo built the turn from",
   "additionalProperties": false,
   "properties": {
    "rules": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "e.g. [\"06 §5.6\", \"06 §6 question\"]"
    },
    "playbook_step": {
     "type": "string",
     "description": "e.g. \"discharge playbook §3, turn 4\""
    },
    "references": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "e.g. [\"discharge-process.md §7.3\"]"
    },
    "skills": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "turn_record": {
   "type": "object",
   "description": "The reply_check object on every turn spec (09 §9). Stored by the app, never shown to the user.",
   "required": [
    "chat_id",
    "turn_id",
    "counted_turn",
    "run",
    "action",
    "last_reply"
   ],
   "additionalProperties": false,
   "properties": {
    "chat_id": {
     "type": "string"
    },
    "turn_id": {
     "type": "string",
     "description": "The turn spec's turn.id"
    },
    "user_ref": {
     "type": "string",
     "description": "The app's user reference. Never a name."
    },
    "tool": {
     "type": "string"
    },
    "place": {
     "$ref": "#/$defs/place"
    },
    "counted_turn": {
     "type": "integer",
     "minimum": 0,
     "description": "Number of this turn among the counted turns of the chat (09 §1). 0 only for the rating question, which is not a counted turn."
    },
    "run": {
     "type": "integer",
     "minimum": 0,
     "description": "Misses in a row, after reading the last reply"
    },
    "action": {
     "enum": [
      "answer",
      "opening",
      "rating",
      "reset",
      "ask_directly"
     ]
    },
    "say": {
     "enum": [
      "opening",
      "rating",
      "reset"
     ],
     "description": "Set when the app must show one of the three fixed lines with this response"
    },
    "ask": {
     "type": "object",
     "description": "What this turn asks the user for. Leave out when it asks nothing.",
     "required": [
      "kind",
      "text"
     ],
     "additionalProperties": false,
     "properties": {
      "kind": {
       "enum": [
        "question",
        "figures",
        "fill_in",
        "pick_pattern",
        "direct_question",
        "rating"
       ]
      },
      "text": {
       "type": "string",
       "maxLength": 300
      }
     }
    },
    "last_reply": {
     "type": "object",
     "description": "How the user's reply to the previous counted turn was read",
     "required": [
      "class"
     ],
     "additionalProperties": false,
     "properties": {
      "class": {
       "$ref": "#/$defs/reply_class"
      },
      "quote": {
       "type": "string",
       "maxLength": 220,
       "description": "At most 25 words of the reply, cleaned: people's details replaced with [removed], staff names with their role"
      },
      "why": {
       "type": "string",
       "maxLength": 200,
       "description": "One line: why it was read this way. Required for unsure."
      },
      "cause": {
       "$ref": "#/$defs/cause"
      },
      "priority": {
       "$ref": "#/$defs/priority"
      }
     }
    },
    "sources": {
     "$ref": "#/$defs/sources"
    },
    "recheck": {
     "type": "object",
     "description": "Filled on a reset (09 §6)",
     "required": [
      "user_wants",
      "cause"
     ],
     "additionalProperties": false,
     "properties": {
      "user_wants": {
       "type": "string",
       "maxLength": 250,
       "description": "Step 1: what the user actually wants, one plain sentence"
      },
      "playbook": {
       "type": "string",
       "maxLength": 300,
       "description": "Step 2: what the playbook check found"
      },
      "reference": {
       "type": "string",
       "maxLength": 300,
       "description": "Step 3: what the reference check found"
      },
      "rules": {
       "type": "string",
       "maxLength": 300,
       "description": "Step 4: what the rules check found"
      },
      "cause": {
       "$ref": "#/$defs/cause"
      },
      "fix_in_chat": {
       "type": "string",
       "maxLength": 250,
       "description": "Step 6: what the rework does differently"
      }
     }
    },
    "recovered": {
     "type": "boolean",
     "description": "Set on the turn after a reset's rework, once the next reply is read"
    }
   }
  },
  "history_entry": {
   "type": "object",
   "description": "One turn behind a finding, as it happened",
   "required": [
    "chat_id",
    "turn_id",
    "counted_turn",
    "reply_class",
    "action"
   ],
   "additionalProperties": false,
   "properties": {
    "chat_id": {
     "type": "string"
    },
    "turn_id": {
     "type": "string"
    },
    "counted_turn": {
     "type": "integer",
     "minimum": 0
    },
    "user_ref": {
     "type": "string"
    },
    "tojo_said": {
     "type": "string",
     "maxLength": 300,
     "description": "A short account of Tojo's turn: its type, its claim, its canvas blocks"
    },
    "tojo_asked": {
     "type": "string",
     "maxLength": 300
    },
    "user_reply": {
     "type": "string",
     "maxLength": 300,
     "description": "Cleaned, at most 40 words"
    },
    "reply_class": {
     "$ref": "#/$defs/reply_class"
    },
    "rating": {
     "enum": [
      "good",
      "fine",
      "bad",
      "skipped"
     ]
    },
    "action": {
     "enum": [
      "answer",
      "opening",
      "rating",
      "reset",
      "ask_directly"
     ]
    },
    "sources": {
     "$ref": "#/$defs/sources"
    },
    "recheck_found": {
     "type": "string",
     "maxLength": 400
    },
    "recovered": {
     "type": "boolean"
    }
   }
  },
  "suggested_change": {
   "type": "object",
   "description": "One change to one section of one file (09 §10.3)",
   "required": [
    "change_id",
    "file",
    "file_version",
    "section",
    "kind",
    "words_today",
    "words_suggested",
    "reason",
    "reach",
    "confidence"
   ],
   "additionalProperties": false,
   "properties": {
    "change_id": {
     "type": "string",
     "pattern": "^ch-\\d{4}-\\d{2}-\\d{2}-\\d{2}$",
     "description": "ch-<day>-<nn>"
    },
    "file": {
     "type": "string"
    },
    "file_version": {
     "type": "string",
     "description": "Must match files_read"
    },
    "section": {
     "type": "string",
     "description": "e.g. \"06 §5.6\" or \"playbook §3, turn 4\""
    },
    "kind": {
     "enum": [
      "add",
      "replace",
      "remove"
     ]
    },
    "words_today": {
     "type": "string",
     "description": "Exact words in the file now. For add: the line the new words follow."
    },
    "words_suggested": {
     "type": "string",
     "description": "Exact new words, in the file's own style. Empty for remove."
    },
    "reason": {
     "type": "string",
     "maxLength": 600,
     "description": "Which cause it fixes and what Tojo would have done differently"
    },
    "reach": {
     "enum": [
      "this_subject",
      "every_conversation"
     ],
     "description": "this_subject: one tool or department's playbook or reference; every_conversation: the rules"
    },
    "confidence": {
     "$ref": "#/$defs/priority"
    },
    "touches_standing_rule": {
     "type": "boolean",
     "description": "True if it touches 06 §0 (F1 to F11) or 08. The back end must flag it."
    }
   }
  },
  "request": {
   "type": "object",
   "description": "A fix that is not a text change Tojo can suggest: generator, block registry, app",
   "required": [
    "what",
    "why"
   ],
   "additionalProperties": false,
   "properties": {
    "what": {
     "type": "string",
     "maxLength": 400
    },
    "why": {
     "type": "string",
     "maxLength": 400
    },
    "area": {
     "enum": [
      "generator",
      "block_registry",
      "app",
      "other"
     ]
    }
   }
  },
  "finding": {
   "type": "object",
   "description": "Misses that share one cause and one file section (09 §10.2)",
   "required": [
    "finding_id",
    "priority",
    "cause",
    "tool",
    "place",
    "title",
    "what_happened",
    "history"
   ],
   "additionalProperties": false,
   "properties": {
    "finding_id": {
     "type": "string",
     "pattern": "^f-\\d{4}-\\d{2}-\\d{2}-\\d{2}$",
     "description": "f-<day>-<nn>"
    },
    "priority": {
     "$ref": "#/$defs/priority"
    },
    "priority_raised_because": {
     "type": "string",
     "maxLength": 200,
     "description": "When a priority went up under 09 §8"
    },
    "cause": {
     "$ref": "#/$defs/cause"
    },
    "tool": {
     "type": "string"
    },
    "place": {
     "$ref": "#/$defs/place"
    },
    "section_at_fault": {
     "type": "string",
     "description": "The file section Tojo believes led to the miss"
    },
    "title": {
     "type": "string",
     "maxLength": 120
    },
    "what_happened": {
     "type": "string",
     "maxLength": 450,
     "description": "At most 60 words"
    },
    "chats": {
     "type": "integer",
     "minimum": 1
    },
    "misses": {
     "type": "integer",
     "minimum": 1
    },
    "history": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/history_entry"
     }
    },
    "suggested_changes": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/suggested_change"
     }
    },
    "requests": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/request"
     }
    },
    "no_change_reason": {
     "type": "string",
     "maxLength": 400,
     "description": "Required when there are no suggested changes and no requests"
    }
   },
   "anyOf": [
    {
     "required": [
      "suggested_changes"
     ],
     "properties": {
      "suggested_changes": {
       "minItems": 1
      }
     }
    },
    {
     "required": [
      "requests"
     ],
     "properties": {
      "requests": {
       "minItems": 1
      }
     }
    },
    {
     "required": [
      "no_change_reason"
     ]
    }
   ]
  },
  "user_note": {
   "type": "object",
   "required": [
    "user_ref",
    "note",
    "turns"
   ],
   "additionalProperties": false,
   "properties": {
    "user_ref": {
     "type": "string"
    },
    "note": {
     "type": "string",
     "maxLength": 300,
     "description": "e.g. \"Wants the figure first, then the reasoning.\""
    },
    "turns": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     },
     "description": "turn_ids that show it"
    },
    "priority": {
     "$ref": "#/$defs/priority"
    }
   }
  }
 }
}